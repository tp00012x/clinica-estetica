# Copy this file to `.env` and fill in the values.
# Env validation lives in src/env.js (@t3-oss/env-nextjs).
# You can skip validation with SKIP_ENV_VALIDATION=1.

# ---- Database ---------------------------------------------------------
# Local development (SQLite — default):
DATABASE_URL="file:./db.sqlite"
#
# Production (Postgres on Neon / Vercel / Supabase). Remember to also
# change `provider = "postgresql"` in prisma/schema.prisma.
# DATABASE_URL="postgresql://user:password@host:5432/db?sslmode=require"

# ---- NextAuth ---------------------------------------------------------
# Required in production. Generate with: npx auth secret
AUTH_SECRET=""

# Discord provider (optional — only needed when a login UI is added).
# AUTH_DISCORD_ID=""
# AUTH_DISCORD_SECRET=""
